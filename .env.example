# Copy to .env and fill in. Only GROQ_API_KEY is needed; everything else has a default.



# Path to the manual if it is not at data/sample-service-manual.pdf
# SPECRAG_PDF=data/sample-service-manual.pdf

# Any Groq chat model. Llama-3.3-70b was retired by Groq on 2026-08-16.
# SPECRAG_LLM_MODEL=openai/gpt-oss-120b

# llm | rules  (defaults to llm when a key is set)
# SPECRAG_MODE=llm

# Deployed API only: the Vercel URL allowed to call it (comma-separated).
# SPECRAG_CORS_ORIGINS=https://f150-spec-finder.vercel.app
